# Keep build context small and free of secrets / local artifacts.
.git
.gitignore

# Secrets and local env
.env
.env.*
!.env.example
server/.env
client/.env

# Python
.venv
venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache

# Node / frontend build output
client/node_modules
client/dist

# Editor / OS
.vscode
.idea
.DS_Store

# Docs and plans (not needed in image)
docs
*.md
!README.md
