# Copy this file to .env and fill in your values.

# Supabase Postgres connection string (Project Settings → Database).
# Use the Session pooler or Direct connection (port 5432), NOT the
# transaction pooler (6543) — Alembic migrations need it.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Supabase project URL — used to verify Supabase Auth access tokens (JWKS).
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon (public) key — NOT a secret. Used ONLY by
# scripts/seed_demo_business_accounts.py to log demo users in for an access token.
# If unset here, the script falls back to VITE_SUPABASE_ANON_KEY in client/.env.
SUPABASE_ANON_KEY=<anon-public-key>

# Optimization algorithm switch: qaoa (default) or brute_force.
# QAOA is the default combinatorial solver (runs on the Aer simulator). Set brute_force
# to disable QAOA server-wide for debugging — at the current PoC scale (4-5 qubits)
# brute-force is actually faster and exact. Invalid values fall back to qaoa.
OPTIMIZATION_ALGORITHM=qaoa

# Email Alert System (Optional)
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Admin bootstrap — used ONLY by scripts/seed_admin.py to create the admin account.
# The service-role key is a secret: never expose it to the client or commit the real
# value. Admin is granted via app_metadata, which only this key can write.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-admin-password>
