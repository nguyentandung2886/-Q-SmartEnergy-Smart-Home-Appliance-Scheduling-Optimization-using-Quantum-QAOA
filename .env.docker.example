# Copy this file to .env.docker and fill in real values before running docker-compose.
# NEVER commit .env.docker to git.

# ── SQL Server ────────────────────────────────────────────
# SA password must be >= 8 chars, with uppercase, lowercase, digit, and symbol.
SA_PASSWORD=ReplaceMe_Strong#1

# ── API backend ───────────────────────────────────────────
# Must match SA_PASSWORD above. sqlserver is the Docker service hostname.
DATABASE_URL=mssql+pyodbc://sa:ReplaceMe_Strong#1@sqlserver/q_smartenergy?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL_TEST=

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

GEMINI_API_KEY=your-real-gemini-api-key-here

# ── Frontend build arg ────────────────────────────────────
# Where the browser sends API requests. Keep localhost:8000 for local Docker.
VITE_API_BASE_URL=http://localhost:8000
