FROM python:3.11-slim

WORKDIR /app

# Install Python dependencies (server + q-smartenergy pipeline)
COPY server/requirements.txt ./server-requirements.txt
COPY q-smartenergy/requirements.txt ./qse-requirements.txt
RUN pip install --no-cache-dir -r server-requirements.txt -r qse-requirements.txt

# Copy source
COPY server/ ./server/
COPY q-smartenergy/ ./q-smartenergy/

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Run as a non-root user; give it ownership of the SQLite data volume mount point.
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app
USER appuser

WORKDIR /app/server
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
