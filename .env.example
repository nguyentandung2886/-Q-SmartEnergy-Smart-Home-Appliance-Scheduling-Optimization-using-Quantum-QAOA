# Copy this file to .env and fill in real values before running docker-compose.
# Docker Compose reads this single .env automatically — both for ${...}
# interpolation in docker-compose.yml AND as the api container's env_file.
# NEVER commit .env to git (it is gitignored).

# ── Database (SQLite) ─────────────────────────────────────
# Stored on the api_data Docker volume so it survives restarts.
# 4 slashes = absolute path inside the container.
DATABASE_URL=sqlite:////app/data/q_smartenergy.db

# ── Auth ──────────────────────────────────────────────────
# Strong random value, >= 32 chars. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ── AI explanation (optional) ─────────────────────────────
# Leave blank to disable the Gemini explanation feature gracefully.
GEMINI_API_KEY=your-real-gemini-api-key-here

# ── Frontend build arg ────────────────────────────────────
# Browser → /api is proxied to the api container by nginx (see nginx.conf),
# so it works same-origin with no CORS. Override only for a custom setup.
VITE_API_BASE_URL=/api
