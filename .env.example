# Copy this file to .env and fill in real values before running docker-compose.
# Docker Compose reads this single .env automatically — both for ${...}
# interpolation in docker-compose.yml AND as the api container's env_file.
# NEVER commit .env to git (it is gitignored).

# ── Database (Supabase Postgres) ──────────────────────────
# Connection string from Supabase → Project Settings → Database.
# Use the Session pooler or Direct connection (port 5432), NOT the
# transaction pooler (6543) — Alembic migrations need it.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# ── Auth (Supabase Auth) ──────────────────────────────────
# Your Supabase project URL. Used to verify Supabase access tokens
# against the project's public keys (JWKS). No secret needed.
SUPABASE_URL=https://<project-ref>.supabase.co

# ── AI explanation (optional) ─────────────────────────────
# Leave blank to disable the Gemini explanation feature gracefully.
GEMINI_API_KEY=your-real-gemini-api-key-here

# ── Frontend build args ───────────────────────────────────
# Browser → /api is proxied to the api container by nginx (see nginx.conf),
# so it works same-origin with no CORS. Override only for a custom setup.
VITE_API_BASE_URL=/api
# Supabase config for the browser (frontend). anon/publishable key is safe to expose.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
